{%- comment -%}
  Accepts: product, index (number)
{%- endcomment -%}
{%- liquid
  assign code = index | prepend: '00' | slice: -3, 3
  assign genus = product.type | default: product.vendor
  assign price_bucket = product.price | divided_by: 100
  assign card_form_id = 'CardForm-' | append: product.id
  assign tag_text = product.tags | join: ' '
  assign search_text = product.title | append: ' ' | append: genus | append: ' ' | append: product.vendor | append: ' ' | append: tag_text | downcase

  # Plants left across the pot sizes on sale; only counted when Shopify tracks every one of them
  assign stock_left = 0
  assign stock_counted = product.available
  for variant in product.variants
    if variant.available
      if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
        assign stock_left = stock_left | plus: variant.inventory_quantity
      else
        assign stock_counted = false
      endif
    endif
  endfor
  assign low_stock_at = settings.low_stock_at | default: 1
-%}
<article class="card{% unless product.available %} is-soldout{% endunless %}" data-price="{{ price_bucket }}" data-search="{{ search_text | escape }}">
  <a class="card__media" href="{{ product.url }}" data-open-dialog="ProductDialog-{{ product.id }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 33vw, (min-width: 560px) 50vw, 100vw', alt: product.featured_image.alt | default: product.title }}
    {%- else -%}
      <img src="{{ 'ra-mascot.png' | asset_url }}" alt="" class="card__placeholder" loading="lazy" width="240" height="240">
    {%- endif -%}
    {%- unless product.available -%}<span class="tag tag--soldout">Sold out</span>{%- endunless -%}
  </a>
  <div class="card__body">
    <div class="card__meta mono">
      <span>RA >_ {{ code }}</span>
      {%- if genus != blank -%}<span>{{ genus | upcase }}</span>{%- endif -%}
    </div>
    <div class="card__title-row">
      <h3 class="card__title"><a href="{{ product.url }}" data-open-dialog="ProductDialog-{{ product.id }}">{{ product.title }}</a></h3>
      {% render 'price-mono', product: product %}
    </div>
    {%- comment -%} With the plant picker, the count comes from the plant photos, which cards don't load {%- endcomment -%}
    {%- if stock_counted and stock_left > 0 and settings.plant_picker != true -%}
      <p class="card__stock stock-note{% if stock_left <= low_stock_at %} is-low{% endif %}" data-stock-note>{% if stock_left <= low_stock_at %}Only {% endif %}{{ stock_left }} left</p>
    {%- endif -%}
    <a class="card__link" href="{{ product.url }}" data-open-dialog="ProductDialog-{{ product.id }}">
      {%- if product.images.size > 1 -%}See what it can grow into{%- else -%}View details{%- endif -%}
    </a>
    {%- if product.available -%}
      {%- comment -%} With the plant picker, plants are chosen by photo in the quick view, not added from the card {%- endcomment -%}
      {%- if product.has_only_default_variant and settings.plant_picker != true -%}
        {%- liquid
          assign v = product.selected_or_first_available_variant
          assign v_stock = ''
          if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
            assign v_stock = v.inventory_quantity
          endif
        -%}
        {%- form 'product', product, id: card_form_id, class: 'card__form', data-add-form: '' -%}
          <input type="hidden" name="id" value="{{ v.id }}" data-stock="{{ v_stock }}">
          <button type="submit" class="btn btn--outline btn--block" data-add-button>Add to cart</button>
          {% render 'qty-stepper' %}
        {%- endform -%}
      {%- else -%}
        <div class="card__form">
          <button type="button" class="btn btn--outline btn--block" data-open-dialog="ProductDialog-{{ product.id }}">{% if settings.plant_picker %}Choose your plants{% else %}Choose an option{% endif %}</button>
        </div>
      {%- endif -%}
    {%- else -%}
      <button type="button" class="btn btn--outline btn--block" disabled>Sold out</button>
    {%- endif -%}
  </div>

  <dialog class="product-dialog" id="ProductDialog-{{ product.id }}" aria-label="{{ product.title | escape }}">
    <button type="button" class="dialog-close" data-close-dialog aria-label="Close">&times;</button>
    {% render 'product-detail', product: product, heading_tag: 'h2', context: 'dialog' %}
  </dialog>
</article>
