<div class="page-width">
  <h1>{{ 'customer.account' | t }}</h1>
  <a href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a>

  <h2>{{ 'customer.orders' | t }}</h2>
  {% paginate customer.orders by 20 %}
    <ul>
      {% for order in customer.orders %}
        <li><a href="{{ order.customer_url }}">{{ order.name }}</a> &ndash; {{ order.total_price | money }}</li>
      {% endfor %}
    </ul>
    {{ paginate | default_pagination }}
  {% endpaginate %}

  <a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }}</a>
</div>
