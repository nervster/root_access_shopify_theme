<div class="page-width">
  <h1>{{ 'customer.order' | t: name: order.name }}</h1>
  <ul>
    {% for line_item in order.line_items %}
      <li>{{ line_item.title }} &times; {{ line_item.quantity }} &ndash; {{ line_item.final_line_price | money }}</li>
    {% endfor %}
  </ul>
  <p>{{ order.total_price | money }}</p>
  <a href="{{ routes.account_url }}">{{ 'customer.account' | t }}</a>
</div>
