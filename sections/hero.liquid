{%- liquid
  assign available_count = 0
  for p in collections.all.products
    if p.available
      assign available_count = available_count | plus: 1
    endif
  endfor
-%}
<section class="hero dotgrid">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow mono">{{ section.settings.eyebrow }}</p>
      <h1 class="hero__title">
        <span>{{ section.settings.line_1 }}</span>
        <span class="accent">{{ section.settings.line_2 }}</span>
      </h1>
      <p class="hero__sub">{{ section.settings.subhead }}</p>

      {%- if available_count > 0 -%}
        <a class="cta" href="#collection">
          <span>{{ section.settings.cta_label }}</span>
          <span class="cta__count">{{ available_count }} {% if available_count == 1 %}variety{% else %}varieties{% endif %}</span>
        </a>
      {%- else -%}
        <a class="cta" href="#notify">
          <span>Get notified</span>
          <span class="cta__count">Out of stock</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Root Access >_ Houston, TX" },
    { "type": "text", "id": "line_1", "label": "Headline line 1", "default": "Nature grows." },
    { "type": "text", "id": "line_2", "label": "Headline line 2 (accent color)", "default": "We geek out." },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Uncommon plants. Thoughtful automation. A little engineering behind every new leaf." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore the collection" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
