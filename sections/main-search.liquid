<div class="page-width">
  <h1>{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    <button type="submit">{{ 'search.submit' | t }}</button>
  </form>
  {% if search.performed %}
    {% paginate search.results by 24 %}
      {% if search.results_count == 0 %}
        <p>{{ 'search.no_results' | t: terms: search.terms }}</p>
      {% else %}
        <ul>
          {% for item in search.results %}
            <li><a href="{{ item.url }}">{{ item.title }}</a></li>
          {% endfor %}
        </ul>
        {{ paginate | default_pagination }}
      {% endif %}
    {% endpaginate %}
  {% endif %}
</div>

{% schema %}
{
  "name": "t:sections.main.name",
  "settings": []
}
{% endschema %}
