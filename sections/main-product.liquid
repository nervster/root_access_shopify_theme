<section class="product-page">
  <div class="wrap">
    <a class="back-link" href="{{ routes.root_url }}#collection">Back to all plants</a>
    {% render 'product-detail', product: product, heading_tag: 'h1', context: 'page' %}
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product",
  "class": "section-product",
  "settings": []
}
{% endschema %}
