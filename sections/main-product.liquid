<div class="page-width">
  <h1>{{ product.title }}</h1>
  {% if product.featured_image %}
    {{ product.featured_image | image_url: width: 800 | image_tag }}
  {% endif %}
  <p>{{ product.selected_or_first_available_variant.price | money }}</p>
  {{ product.description }}

  {% form 'product', product %}
    <select name="id">
      {% for variant in product.variants %}
        <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
          {{ variant.title }}
        </option>
      {% endfor %}
    </select>
    <button type="submit" {% unless product.available %}disabled{% endunless %}>
      {% if product.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}
    </button>
  {% endform %}
</div>

{% schema %}
{
  "name": "t:sections.main.name",
  "settings": []
}
{% endschema %}
