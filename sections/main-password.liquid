<section class="password dotgrid">
  <div class="wrap wrap--narrow password__inner">
    {% render 'logo-tile', size: 'lg' %}
    <h1 class="hero__title"><span>Nature grows.</span><span class="accent">We're almost ready.</span></h1>
    {%- if shop.password_message != blank -%}<p class="hero__sub">{{ shop.password_message }}</p>{%- endif -%}
    {% render 'notify-form', form_id: 'NotifyPassword' %}
    <details class="password__owner">
      <summary>Store owner? Enter password</summary>
      {%- form 'storefront_password', class: 'notify' -%}
        {{ form.errors | default_errors }}
        <div class="notify__row">
          <label class="visually-hidden" for="StorePass">Password</label>
          <input id="StorePass" class="notify__input" type="password" name="password" autocomplete="current-password">
          <button class="btn btn--solid" type="submit">Enter</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Password page", "class": "section-password", "settings": [] }
{% endschema %}
