<div class="page-width">
  <h1>{{ blog.title }}</h1>
  {% paginate blog.articles by 10 %}
    {% for article in blog.articles %}
      <article>
        <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
        {{ article.excerpt_or_content }}
      </article>
    {% endfor %}
    {{ paginate | default_pagination }}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:sections.main.name",
  "settings": []
}
{% endschema %}
