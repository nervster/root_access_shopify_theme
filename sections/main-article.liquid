<section class="basic-page">
  <div class="wrap wrap--narrow">
    <p class="eyebrow mono">{{ article.published_at | date: '%b %d, %Y' }}</p>
    <h1 class="section-title">{{ article.title }}</h1>
    <div class="rte">{{ article.content }}</div>
  </div>
</section>
{% schema %}
{ "name": "Article", "class": "section-article", "settings": [] }
{% endschema %}
