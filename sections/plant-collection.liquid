{%- liquid
  assign source = section.settings.collection
  if source == blank and collection != blank
    assign source = collection
  endif
  if source == blank
    assign source = collections.all
  endif
  assign total = source.products_count
  assign available_count = 0
  for p in source.products
    if p.available
      assign available_count = available_count | plus: 1
    endif
  endfor
  assign price_points = source.products | where: 'available' | map: 'price' | uniq | sort
  assign heading = section.settings.heading
  if template.name == 'collection' and section.settings.collection == blank
    assign heading = collection.title
  endif
-%}
<section class="collection" id="collection">
  <div class="wrap">
    <div class="collection__head">
      <div>
        <p class="eyebrow mono">01 >/ The collection</p>
        <h2 class="section-title">{{ heading }}</h2>
      </div>
      <p class="collection__count">
        {%- if available_count > 0 -%}
          {{ available_count }} in stock
        {%- else -%}
          Out of stock
        {%- endif -%}
      </p>
    </div>

    {%- if available_count == 0 -%}
      <div class="empty" id="notify">
        <img class="empty__mascot" src="{{ 'ra-mascot.png' | asset_url }}" alt="" width="160" height="160" loading="lazy">
        <div class="empty__body">
          <h3 class="empty__title">We're out of stock.</h3>
          <p class="empty__copy">{{ section.settings.empty_copy }}</p>
          {% render 'notify-form', form_id: 'NotifyCollection' %}
        </div>
      </div>
    {%- endif -%}

    {%- if total > 0 -%}
      {%- if price_points.size > 1 -%}
        <div class="filters">
          <div class="chips" role="group" aria-label="Filter by price">
            <button type="button" class="chip is-active" data-filter="all" aria-pressed="true">All plants</button>
            {%- for cents in price_points -%}
              <button type="button" class="chip" data-filter="{{ cents | divided_by: 100 }}" aria-pressed="false">{{ cents | money_without_trailing_zeros }}</button>
            {%- endfor -%}
          </div>
          {%- if section.settings.tagline != blank -%}<p class="filters__tag">{{ section.settings.tagline }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- paginate source.products by 48 -%}
        <div class="grid" data-grid>
          {%- for product in source.products -%}
            {%- if product.available -%}
              {%- assign idx = paginate.current_offset | plus: forloop.index -%}
              {% render 'product-card', product: product, index: idx, size_note: section.settings.size_note, badge_default: section.settings.badge %}
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.show_sold_out -%}
            {%- for product in source.products -%}
              {%- unless product.available -%}
                {%- assign idx = paginate.current_offset | plus: forloop.index -%}
                {% render 'product-card', product: product, index: idx, size_note: section.settings.size_note, badge_default: section.settings.badge %}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
        <p class="grid__none" data-grid-none hidden>No plants at this price right now.</p>
        {%- if paginate.pages > 1 -%}
          <nav class="pager" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}#collection">Previous</a>{%- endif -%}
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}#collection">Next</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Plant collection",
  "class": "section-collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show every product in your store." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your next obsession." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "A new addition to your living system." },
    { "type": "text", "id": "badge", "label": "Default photo tag", "default": "The green collection", "info": "Products tagged \"Variegated\" show that tag instead." },
    { "type": "text", "id": "size_note", "label": "Default size note", "default": "Established plant, 3–4\" pot", "info": "Override per product with a custom.pot_size metafield." },
    { "type": "checkbox", "id": "show_sold_out", "label": "Show sold-out plants", "default": true },
    { "type": "textarea", "id": "empty_copy", "label": "Out-of-stock message", "default": "New specimens are rooting now. Leave your email and we'll let you know as soon as plants are ready for pickup." }
  ],
  "presets": [{ "name": "Plant collection" }]
}
{% endschema %}
